# Copy to .env (git-ignored) or run scripts/db/setup-local-db.ps1, which
# generates .env with real local credentials. Never commit .env.

# Development database (used by `mvnw spring-boot:run`)
DB_URL=jdbc:postgresql://127.0.0.1:5432/newsportal_dev
DB_USERNAME=newsportal_dev
DB_PASSWORD=change-me

# Test database (used by `mvnw test`; wiped on every test run)
TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/newsportal_test
TEST_DB_USERNAME=newsportal_test
TEST_DB_PASSWORD=change-me

# Email. Development default is "outbox": messages are written to .mail-outbox/
# (git-ignored; contains live sign-in links). The pilot profile requires smtp:
# MAIL_MODE=smtp, MAIL_FROM, SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD.
# MAIL_MODE=outbox
# PUBLIC_BASE_URL=http://127.0.0.1:5173

# First system administrator, created once at startup. Remove both after first use.
# NEWSPORTAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# NEWSPORTAL_BOOTSTRAP_ADMIN_PASSWORD=choose-a-long-passphrase

# Account deletion: recovery period (ISO-8601) and the out-of-database ledger file.
# DELETION_RECOVERY_PERIOD=P7D
# DELETION_LEDGER_FILE=../data/deletion-ledger.txt

# Feed ingestion scheduler (default true). Set false to stop automatic fetching.
# INGESTION_SCHEDULER_ENABLED=true

# Optional server binding (defaults: 127.0.0.1 and 8081)
# SERVER_ADDRESS=127.0.0.1
# SERVER_PORT=8081
